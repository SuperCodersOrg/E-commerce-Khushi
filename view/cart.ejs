         document.querySelector(".payment-options").addEventListener("click", async(event) => {
            let button = event.target.closest("button");
            if (!button) return;
            let contact = document.getElementById("contact").value.trim();
            let houseNo = document.getElementById("houseNo").value.trim();
            let address = document.getElementById("address").value.trim();
            let pincode = document.getElementById("pincode").value.trim();
            let city = document.getElementById("city").value.trim();
            let state = document.getElementById("state").value;

            if (!contact || !houseNo || !address || !pincode || !city || !state) {
                document.getElementById("message").innerText =
                    "Please fill in all delivery details.";
                return;
            }
            let fullAddress = houseNo + ", " + address + ", " + city + ", " + state + " - " + pincode;
