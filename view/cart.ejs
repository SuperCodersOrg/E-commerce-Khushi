                    });
                    window.location.reload(); 
                } else{
                    message.innerText= verifyData.message||"Payment verification failde";
                    button.disabled=false;
                }
            },
            modal:{
                ondismiss: function(){
                    message.innerText="Payment cancelled. You can try again."
                    button.disabled=false;
                }
            }
        }
        let checkout = new Razorpay(options);
        checkout.on("payment.failed",function(){
            message.innerText="Payment failed. please try again";
            button.disabled=false;
        })
        checkout.open();

    }catch (error) {
        console.log(error);
        message.innerText = "Something went wrong.";
